---
import Layout from "../../layouts/Layout.astro";
import CategoriaTag from "../../components/CategoriaTag.astro";
import DificultadDots from "../../components/DificultadDots.astro";
import Cronometro from "../../components/Cronometro.astro";
import RevelarSolucion from "../../components/RevelarSolucion.astro";
import Icono from "../../components/Icono.astro";
import { getCollection } from "astro:content";
import { partirCuerpo } from "../../lib/acertijos";

export async function getStaticPaths() {
  const acertijos = await getCollection("acertijos");
  return acertijos.map((acertijo) => ({
    params: { slug: acertijo.id },
    props: { acertijo },
  }));
}

const { acertijo } = Astro.props;
const { title, categoria, dificultad, tiempoEstimado, imagen, tags } = acertijo.data;
const { enunciadoHtml, solucionHtml } = partirCuerpo(acertijo.body ?? "");

const acertijos = (await getCollection("acertijos")).sort((a, b) =>
  a.id.localeCompare(b.id),
);
const otros = acertijos.filter((a) => a.id !== acertijo.id);
const siguiente = otros[Math.floor(Math.random() * otros.length)];
const numeroExpediente = String(
  acertijos.findIndex((a) => a.id === acertijo.id) + 1,
).padStart(3, "0");
---

<Layout title={title} categoria={categoria}>
  <main transition:name="pagina-contenido">
    <article class="container juego">
      <a href="/jugar" class="volver">
        <Icono nombre="flecha" class="volver-icono" /> Volver a todos los enigmas
      </a>

      <div class="juego-cabecera">
        <div class="juego-imagen" transition:name={`imagen-${acertijo.id}`}>
          <img src={imagen} alt="" width="640" height="480" />
        </div>
        <div class="juego-info">
          <CategoriaTag categoria={categoria} />
          <h1 class="juego-titulo" transition:name={`titulo-${acertijo.id}`}>{title}</h1>
          <div class="juego-meta">
            <span class="meta-item"><Icono nombre="reloj" class="meta-icono" />{tiempoEstimado} min estimados</span>
            <DificultadDots dificultad={dificultad} />
          </div>
          <Cronometro />
        </div>
      </div>

      <section class="enunciado" aria-label="Enunciado del enigma">
        <div class="enunciado-etiqueta">
          <span class="kicker">El enigma</span>
          <span class="enunciado-numero">Expediente n.º {numeroExpediente}</span>
        </div>
        <div class="enunciado-texto" set:html={enunciadoHtml} />
      </section>

      <RevelarSolucion solucionHtml={solucionHtml} />

      {tags.length > 0 && (
        <ul class="tags">
          {tags.map((t: string) => <li>#{t}</li>)}
        </ul>
      )}

      {siguiente && (
        <a href={`/acertijos/${siguiente.id}/`} class="siguiente">
          <span class="kicker">Siguiente</span>
          <span class="siguiente-titulo">{siguiente.data.title} →</span>
        </a>
      )}
    </article>
  </main>
</Layout>

<style>
  .juego {
    padding-block: 2.5rem 5rem;
    max-width: 52rem;
  }
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    color: var(--color-tinta-suave);
    margin-bottom: 2rem;
  }
  .volver-icono {
    transform: rotate(180deg);
    width: 1em;
    height: 1em;
  }

  .juego-cabecera {
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 720px) {
    .juego-cabecera {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: center;
    }
  }
  .juego-imagen {
    border: 2.5px solid var(--color-tinta);
    border-radius: var(--radio-tarjeta);
    overflow: hidden;
    background: var(--acento-suave);
    aspect-ratio: 4 / 3;
  }
  .juego-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .juego-info {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .juego-titulo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    line-height: 1.1;
  }
  .juego-meta {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: 0.85rem;
    color: var(--color-tinta-suave);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .meta-icono {
    width: 1em;
    height: 1em;
  }

  .enunciado {
    position: relative;
    margin-block: 2.5rem;
    padding: 2.2rem 2.4rem 2.4rem 2.6rem;
    background: var(--color-papel);
    border: 2px solid var(--color-tinta);
    border-left: 7px solid var(--acento);
    border-radius: 4px 18px 18px 4px;
    box-shadow: var(--sombra-tarjeta);
  }
  .enunciado-etiqueta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.3rem;
    padding-bottom: 0.9rem;
    border-bottom: 1.5px dashed var(--color-borde);
  }
  .enunciado-numero {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    letter-spacing: 0.03em;
    color: var(--color-tinta-suave);
    font-variant-numeric: tabular-nums;
  }
  .enunciado-texto {
    font-family: var(--font-relato);
    font-size: 1.38rem;
    line-height: 1.68;
    color: var(--color-tinta);
  }
  .enunciado-texto :global(p) {
    margin-bottom: 1rem;
  }
  .enunciado-texto :global(p:first-of-type)::first-letter {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: 3.4rem;
    line-height: 0.75;
    float: left;
    margin: 0.05em 0.08em 0 0;
    color: var(--acento);
  }

  .tags {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    list-style: none;
    margin-top: 2rem;
    font-size: 0.78rem;
    color: var(--color-tinta-suave);
    font-family: var(--font-ui);
  }

  .siguiente {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 2px dashed var(--color-borde);
    text-decoration: none;
    color: var(--color-tinta);
  }
  .siguiente-titulo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: 1.4rem;
  }
</style>
