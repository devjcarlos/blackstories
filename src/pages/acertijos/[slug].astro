---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameMasterToggle from '../../components/GameMasterToggle.astro';
import Timer from '../../components/Timer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('acertijos');
  return all.map((acertijo, index) => ({
    params: { slug: acertijo.id },
    props:  { acertijo, index, total: all.length, all },
  }));
}

const { acertijo, index, total, all } = Astro.props;
const { title, dificultad, categoria, tiempoEstimado, imagen } = acertijo.data;
const slug = acertijo.id;

const partes    = acertijo.body.split('<!-- SOLUCIÓN -->');
const enunciado = partes[0].trim();
const solucion  = (partes[1] ?? '').trim();

const prev = all[(index - 1 + total) % total];
const next = all[(index + 1) % total];

const labels: Record<string,string> = {
  oscuro:'Oscuro', surreal:'Surreal', humor:'Humor',
  clasico:'Clásico', historico:'Histórico', cortito:'Cortito',
};
---

<BaseLayout title={`${title} — Historias Negras`} description={enunciado.slice(0,155)}>

  <article data-cat={categoria}>

    <!-- ══ Banner de categoría ══════════════════════════════════ -->
    <div class="banner">
      <div class="banner__inner container">

        <a href="/jugar" data-nav="back" class="back-link">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
          </svg>
          Todos los acertijos
        </a>

        <span class="banner__badge">{labels[categoria]}</span>

        <h1
          class="banner__title"
          style={`view-transition-name: title-${slug}`}
        >{title}</h1>

        <!-- Meta -->
        <div class="banner__meta">
          <div class="dots-row" aria-label={`Dificultad ${dificultad}/5`}>
            <span class="meta-label">Dif.</span>
            {Array.from({length:5}).map((_,i) => (
              <span class={`dot ${i < dificultad ? 'dot--on' : 'dot--off'}`}/>
            ))}
          </div>
          <div class="meta-time">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
              <path d="M12 6v6l4 2" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            ~{tiempoEstimado} min
          </div>
        </div>
      </div>
    </div>

    <!-- ══ Imagen (morph desde la card) ═════════════════════════ -->
    {imagen && (
      <div class="hero-img-wrap container">
        <img
          src={imagen}
          alt={title}
          class="hero-img"
          style={`view-transition-name: img-${slug}`}
        />
      </div>
    )}

    <!-- ══ Contenido ═════════════════════════════════════════════ -->
    <div class="content container">

      <!-- Enunciado -->
      <div class="enigma">
        <p class="enigma__label">El enigma</p>
        <p class="enigma__text">{enunciado}</p>
      </div>

      <!-- Timer -->
      <div class="timer-wrap">
        <div>
          <p class="widget-label">Cronómetro</p>
          <p class="widget-sub">Se activa en rojo a los {tiempoEstimado} min</p>
        </div>
        <Timer tiempoEstimado={tiempoEstimado} />
      </div>

      <!-- Solución -->
      {solucion
        ? <GameMasterToggle solucion={solucion} categoria={categoria} />
        : <p class="no-solution">Solución no disponible.</p>
      }

      <!-- Navegación -->
      <nav class="nav-cards">
        <a href={`/acertijos/${prev.id}`} data-nav="prev" class="nav-btn nav-btn--prev">
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
          </svg>
          <div>
            <span class="nav-btn__label">Anterior</span>
            <span class="nav-btn__name">{prev.data.title}</span>
          </div>
        </a>

        <span class="nav-count">{index + 1} / {total}</span>

        <a href={`/acertijos/${next.id}`} data-nav="next" class="nav-btn nav-btn--next">
          <div>
            <span class="nav-btn__label">Siguiente</span>
            <span class="nav-btn__name">{next.data.title}</span>
          </div>
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </nav>

    </div>
  </article>

</BaseLayout>

<style>
  /* ── Banner ───────────────────────────────────────────────── */
  .banner {
    background: var(--bg, var(--cream-2));
    border-bottom: 1.5px solid var(--border, var(--cream-border));
  }

  .banner__inner {
    padding-top: 48px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-sans);
    font-size: .875rem;
    font-weight: 500;
    color: var(--mu, var(--muted));
    text-decoration: none;
    transition: opacity .15s;
    width: fit-content;
  }
  .back-link:hover { opacity: .6; }
  .back-link svg { transition: translate .15s; }
  .back-link:hover svg { translate: -3px 0; }

  .banner__badge {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .6875rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    padding: 4px 12px;
    border-radius: 99px;
    background: var(--accent, var(--ink));
    color: #fff;
    width: fit-content;
  }

  .banner__title {
    font-family: var(--f-headline);
    font-weight: 700;
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: .95;
    letter-spacing: -.01em;
    color: var(--tx, var(--ink));
    font-optical-sizing: auto;
  }

  .banner__meta {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .dots-row { display: flex; align-items: center; gap: 5px; }
  .meta-label {
    font-family: var(--f-display);
    font-size: .75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .1em;
    color: var(--mu, var(--muted));
    margin-right: 2px;
  }

  .dot { width: 8px; height: 8px; border-radius: 2px; }
  .dot--on  { background: var(--accent, var(--ink)); }
  .dot--off { background: var(--border, var(--cream-border)); }

  .meta-time {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--f-display);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--mu, var(--muted));
  }

  /* ── Imagen hero ──────────────────────────────────────────── */
  .hero-img-wrap {
    margin-top: -1px;
  }

  .hero-img {
    width: 100%;
    max-height: 380px;
    object-fit: cover;
    display: block;
    border-radius: 0 0 20px 20px;
    border: 1.5px solid var(--cream-border);
    border-top: none;
  }

  /* ── Contenido ────────────────────────────────────────────── */
  .content {
    padding-top: 48px;
    padding-bottom: 80px;
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 720px;
  }

  /* Enigma */
  .enigma {
    border-radius: 16px;
    padding: 28px 32px;
    background: var(--cream-2);
    border: 1.5px solid var(--cream-border);
    border-left: 4px solid var(--blood);
  }

  .enigma__label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: 14px;
  }

  .enigma__text {
    font-family: var(--f-serif);
    font-size: 1.35rem;
    line-height: 1.65;
    color: var(--ink);
  }

  /* Timer */
  .timer-wrap {
    border-radius: 14px;
    padding: 20px 24px;
    background: var(--cream-2);
    border: 1.5px solid var(--cream-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .widget-label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 4px;
  }

  .widget-sub {
    font-size: .8125rem;
    color: var(--cream-border);
  }

  /* Nav entre acertijos */
  .nav-cards {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--cream-border);
    margin-top: 8px;
  }

  .nav-count {
    font-family: var(--f-display);
    font-size: .8125rem;
    font-weight: 700;
    color: var(--muted);
    white-space: nowrap;
  }

  .nav-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--cream-border);
    background: transparent;
    text-decoration: none;
    transition: border-color .15s, background .15s;
    max-width: 200px;
  }
  .nav-btn:hover {
    border-color: var(--ink-2);
    background: var(--cream-2);
  }
  .nav-btn svg { flex-shrink: 0; color: var(--muted); }

  .nav-btn__label {
    display: block;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .6875rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .nav-btn__name {
    display: block;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: .875rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
  }

  .nav-btn--next { flex-direction: row-reverse; text-align: right; }

  .no-solution {
    font-style: italic;
    color: var(--muted);
    font-size: .9rem;
  }
</style>

<script>
  function init() {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach(link => {
      link.addEventListener('click', () => {
        const nav = link.dataset.nav;
        document.documentElement.classList.remove('vt-next','vt-prev');
        if (nav === 'next') document.documentElement.classList.add('vt-next');
        if (nav === 'prev') document.documentElement.classList.add('vt-prev');
      });
    });
  }
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:after-preparation', () => {
    document.documentElement.classList.remove('vt-next','vt-prev');
  });
</script>
