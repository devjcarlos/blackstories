---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameMasterToggle from '../../components/GameMasterToggle.astro';
import Timer from '../../components/Timer.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const acertijos = await getCollection('acertijos');
  return acertijos.map((acertijo, index) => ({
    params: { slug: acertijo.id },
    props:  { acertijo, index, total: acertijos.length, todos: acertijos },
  }));
}

const { acertijo, index, total, todos } = Astro.props;
const { title, dificultad, categoria, tiempoEstimado, imagen } = acertijo.data;
const slug = acertijo.id;

const partes    = acertijo.body.split('<!-- SOLUCIÓN -->');
const enunciado = partes[0].trim();
const solucion  = (partes[1] ?? '').trim();

const prevSlug = todos[(index - 1 + total) % total]?.id;
const nextSlug = todos[(index + 1) % total]?.id;

const categoriaLabel: Record<string, string> = {
  clasico:   'Clásico',
  oscuro:    'Oscuro',
  humor:     'Humor',
  historico: 'Histórico',
  cortito:   'Cortito',
  surreal:   'Surreal',
};

const esOscuro = categoria === 'oscuro';
---

<BaseLayout
  title={`${title} — Historias Negras`}
  description={enunciado.slice(0, 155)}
>
  <!-- La página entera adopta el color de la categoría -->
  <div data-theme={categoria} style="min-height: calc(100dvh - 56px);">

    <!-- ─── Header de categoría ─────────────────────────────────── -->
    <div
      class="w-full"
      style="background: var(--cat-bg); border-bottom: 1.5px solid var(--cat-border);"
    >
      <div class="max-w-3xl mx-auto px-5 py-10">

        <!-- Volver -->
        <a
          href="/jugar"
          data-nav="back"
          class="inline-flex items-center gap-1.5 text-sm font-display font-500 mb-8 transition-opacity hover:opacity-60 group"
          style="color: var(--cat-muted);"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
          </svg>
          Todos los acertijos
        </a>

        <!-- Badge -->
        <div class="mb-4">
          <span
            class="font-display font-700 text-xs px-3 py-1 rounded-full uppercase tracking-widest"
            style="background: var(--cat-accent); color: #fff;"
          >
            {categoriaLabel[categoria]}
          </span>
        </div>

        <!-- Título -->
        <h1
          class="font-display font-800 leading-tight mb-6"
          style={`font-size: clamp(2.5rem, 6vw, 4.5rem); color: var(--cat-text); view-transition-name: titulo-${slug};`}
        >
          {title}
        </h1>

        <!-- Meta: dificultad + tiempo -->
        <div class="flex flex-wrap items-center gap-5">
          <div class="flex items-center gap-2">
            <span class="font-display text-xs uppercase tracking-wide" style="color: var(--cat-muted);">Dif.</span>
            <div class="flex gap-1">
              {Array.from({ length: 5 }).map((_, i) => (
                <span
                  class="w-2.5 h-2.5 rounded-sm"
                  style={`background: ${i < dificultad ? 'var(--cat-accent)' : 'var(--cat-border)'};`}
                />
              ))}
            </div>
          </div>
          <div class="flex items-center gap-1.5" style="color: var(--cat-muted);">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
              <path d="M12 6v6l4 2" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <span class="font-display text-xs">~{tiempoEstimado} min</span>
          </div>
        </div>
      </div>

      <!-- Imagen hero (morph desde la card) -->
      {imagen && (
        <div class="max-w-3xl mx-auto px-5 pb-0">
          <div class="rounded-t-2xl overflow-hidden" style="aspect-ratio: 16/6;">
            <img
              src={imagen}
              alt={title}
              class="w-full h-full object-cover"
              style={`view-transition-name: imagen-${slug}`}
            />
          </div>
        </div>
      )}
    </div>

    <!-- ─── Contenido principal ─────────────────────────────────── -->
    <div
      class="max-w-3xl mx-auto px-5 py-12"
      style="background: var(--color-base);"
    >

      <!-- Enunciado -->
      <div
        class="rounded-2xl p-7 mb-8"
        style="background: var(--cat-bg); border: 1.5px solid var(--cat-border); border-left: 4px solid var(--cat-accent);"
      >
        <p
          class="font-display text-xs font-600 uppercase tracking-widest mb-4"
          style="color: var(--cat-accent);"
        >
          El enigma
        </p>
        <p
          class="font-serif leading-relaxed"
          style={`font-size: 1.3rem; color: var(--cat-text);`}
        >
          {enunciado}
        </p>
      </div>

      <!-- Timer -->
      <div
        class="rounded-xl p-5 mb-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4"
        style="background: var(--color-base-soft); border: 1.5px solid var(--color-base-border);"
      >
        <div>
          <p class="font-display text-xs font-600 uppercase tracking-wide mb-1" style="color: var(--color-muted);">Cronómetro</p>
          <p class="text-xs" style="color: var(--color-base-border);">Se activa en rojo a los {tiempoEstimado} min.</p>
        </div>
        <Timer tiempoEstimado={tiempoEstimado} />
      </div>

      <!-- Game Master Toggle -->
      {solucion ? (
        <GameMasterToggle solucion={solucion} accentColor={`var(--cat-accent)`} darkCard={esOscuro} />
      ) : (
        <p class="text-sm italic" style="color: var(--color-muted);">No hay solución disponible.</p>
      )}

      <!-- Navegación -->
      <nav
        class="flex items-center justify-between mt-14 pt-8"
        style="border-top: 1.5px solid var(--color-base-border);"
      >
        <a
          href={`/acertijos/${prevSlug}`}
          data-nav="prev"
          class="flex items-center gap-2 px-4 py-2.5 rounded-full font-display font-500 text-sm border transition-all group"
          style="border-color: var(--color-base-border); color: var(--color-muted);"
          onmouseover="this.style.borderColor='var(--color-ink)'; this.style.color='var(--color-ink)'"
          onmouseout="this.style.borderColor='var(--color-base-border)'; this.style.color='var(--color-muted)'"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"/>
          </svg>
          Anterior
        </a>

        <span class="font-display text-xs tabular-nums" style="color: var(--color-muted);">
          {index + 1} / {total}
        </span>

        <a
          href={`/acertijos/${nextSlug}`}
          data-nav="next"
          class="flex items-center gap-2 px-4 py-2.5 rounded-full font-display font-500 text-sm border transition-all group"
          style="border-color: var(--color-base-border); color: var(--color-muted);"
          onmouseover="this.style.borderColor='var(--color-ink)'; this.style.color='var(--color-ink)'"
          onmouseout="this.style.borderColor='var(--color-base-border)'; this.style.color='var(--color-muted)'"
        >
          Siguiente
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </nav>

    </div>
  </div>
</BaseLayout>

<script>
  function initNavTransitions() {
    document.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach(link => {
      link.addEventListener('click', () => {
        const nav = link.dataset.nav;
        document.documentElement.classList.remove('vt-next', 'vt-prev');
        if (nav === 'next') document.documentElement.classList.add('vt-next');
        if (nav === 'prev') document.documentElement.classList.add('vt-prev');
      });
    });
  }

  document.addEventListener('astro:page-load', initNavTransitions);
  document.addEventListener('astro:after-preparation', () => {
    document.documentElement.classList.remove('vt-next', 'vt-prev');
  });
</script>
