---
import BaseLayout from '../layouts/BaseLayout.astro';
import AcertijoCard from '../components/AcertijoCard.astro';
import { getCollection } from 'astro:content';

const all      = await getCollection('acertijos');
const ordenados = all.sort((a, b) => a.data.dificultad - b.data.dificultad);
const random   = all[Math.floor(Math.random() * all.length)]?.id;

const cats = [
  { id: 'todos',     label: 'Todos' },
  { id: 'oscuro',    label: 'Oscuro' },
  { id: 'surreal',   label: 'Surreal' },
  { id: 'humor',     label: 'Humor' },
  { id: 'clasico',   label: 'Clásico' },
  { id: 'historico', label: 'Histórico' },
  { id: 'cortito',   label: 'Cortito' },
];
---

<BaseLayout title="Jugar — Historias Negras">
  <div class="page container">

    <!-- Cabecera -->
    <header class="page-head">
      <div>
        <p class="eyebrow">{all.length} historias disponibles</p>
        <h1 class="page-title">Acertijos</h1>
      </div>
      {random && (
        <a href={`/acertijos/${random}`} id="btn-random" class="btn-random">
          <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <polyline points="16 3 21 3 21 8"/>
            <line x1="4" y1="20" x2="21" y2="3"/>
            <polyline points="21 16 21 21 16 21"/>
            <line x1="4" y1="4" x2="21" y2="21"/>
          </svg>
          Aleatorio
        </a>
      )}
    </header>

    <!-- Filtros -->
    <div class="filters" role="group" aria-label="Filtrar por categoría">
      {cats.map(c => (
        <button
          class="filter-pill"
          data-cat={c.id}
          aria-pressed={c.id === 'todos' ? 'true' : 'false'}
        >
          {c.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div id="grid" class="grid">
      {ordenados.map((a, i) => (
        <div class="grid-item" data-categoria={a.data.categoria}>
          <AcertijoCard acertijo={a} index={i} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <p id="empty" class="empty hidden">
      Ningún acertijo en esta categoría… por ahora.
    </p>

  </div>
</BaseLayout>

<style>
  .page { padding-top: 56px; padding-bottom: 80px; }

  /* Cabecera */
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 36px;
  }

  .eyebrow {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: 6px;
  }

  .page-title {
    font-family: var(--f-headline);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    color: var(--ink);
    letter-spacing: -.01em;
    font-optical-sizing: auto;
    line-height: 1;
  }

  /* Botón aleatorio */
  .btn-random {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 99px;
    border: 1.5px solid var(--cream-border);
    background: transparent;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .8125rem;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color .15s, color .15s, background .15s;
  }
  .btn-random:hover {
    border-color: var(--ink);
    color: var(--ink);
    background: var(--cream-2);
  }
  .btn-random svg { color: var(--blood); transition: rotate .4s; }
  .btn-random:hover svg { rotate: 180deg; }

  /* Filtros */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 40px;
  }

  .filter-pill {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .8125rem;
    padding: 7px 16px;
    border-radius: 99px;
    border: 1.5px solid var(--cream-border);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: all .15s;
  }
  .filter-pill:hover {
    border-color: var(--ink-2);
    color: var(--ink-2);
    background: var(--cream-2);
  }
  .filter-pill[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--cream);
  }

  /* Grid */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) { .grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 560px) { .grid { grid-template-columns: 1fr; } }

  .grid-item { display: flex; flex-direction: column; }

  /* Empty */
  .empty {
    text-align: center;
    padding: 80px 0;
    font-family: var(--f-serif);
    font-style: italic;
    font-size: 1.5rem;
    color: var(--muted);
  }
  .hidden { display: none; }
</style>

<script>
  function init() {
    const pills   = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    const items   = document.querySelectorAll<HTMLElement>('.grid-item');
    const empty   = document.getElementById('empty');
    const btnRnd  = document.getElementById('btn-random') as HTMLAnchorElement | null;

    function filter(cat: string) {
      let n = 0;
      const visible: string[] = [];
      items.forEach(el => {
        const show = cat === 'todos' || el.dataset.categoria === cat;
        el.style.display = show ? '' : 'none';
        if (show) {
          n++;
          const href = el.querySelector('a')?.getAttribute('href');
          if (href) visible.push(href);
        }
      });
      if (empty) empty.classList.toggle('hidden', n > 0);
      if (btnRnd && visible.length)
        btnRnd.href = visible[Math.floor(Math.random() * visible.length)];
    }

    pills.forEach(p => p.addEventListener('click', () => {
      pills.forEach(x => x.setAttribute('aria-pressed', 'false'));
      p.setAttribute('aria-pressed', 'true');
      filter(p.dataset.cat ?? 'todos');
    }));
  }

  document.addEventListener('astro:page-load', init);
</script>
