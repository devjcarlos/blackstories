---
import BaseLayout from '../layouts/BaseLayout.astro';
import AcertijoCard from '../components/AcertijoCard.astro';
import { getCollection } from 'astro:content';

const acertijos = await getCollection('acertijos');
const ordenados = acertijos.sort((a, b) => a.data.dificultad - b.data.dificultad);

const categorias = [
  { id: 'todos',     label: 'Todos' },
  { id: 'oscuro',    label: 'Oscuro' },
  { id: 'surreal',   label: 'Surreal' },
  { id: 'humor',     label: 'Humor' },
  { id: 'clasico',   label: 'Clásico' },
  { id: 'historico', label: 'Histórico' },
  { id: 'cortito',   label: 'Cortito' },
];

const randomSlug = acertijos[Math.floor(Math.random() * acertijos.length)]?.id;
---

<BaseLayout
  title="Jugar — Historias Negras"
  description="Explora todos los acertijos y elige el tuyo."
>
  <div class="max-w-6xl mx-auto px-5 py-14">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div>
        <p
          class="font-display text-xs font-600 tracking-[0.18em] uppercase mb-2"
          style="color: var(--color-blood);"
        >
          {acertijos.length} historias
        </p>
        <h1
          class="font-display font-800 text-5xl"
          style="color: var(--color-ink);"
        >
          Acertijos
        </h1>
      </div>

      <!-- Botón aleatorio -->
      {randomSlug && (
        <a
          href={`/acertijos/${randomSlug}`}
          id="btn-random"
          class="inline-flex items-center gap-2 px-4 py-2.5 rounded-full font-display font-500 text-sm border transition-all group"
          style="border-color: var(--color-base-border); color: var(--color-muted);"
          onmouseover="this.style.borderColor='var(--color-ink)'; this.style.color='var(--color-ink)'"
          onmouseout="this.style.borderColor='var(--color-base-border)'; this.style.color='var(--color-muted)'"
        >
          <svg class="w-4 h-4 group-hover:rotate-180 transition-transform duration-500" style="color: var(--color-blood);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="16 3 21 3 21 8"/>
            <line x1="4" y1="20" x2="21" y2="3"/>
            <polyline points="21 16 21 21 16 21"/>
            <line x1="4" y1="4" x2="21" y2="21"/>
          </svg>
          Aleatorio
        </a>
      )}
    </div>

    <!-- Filtros -->
    <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filtrar por categoría">
      {categorias.map(cat => (
        <button
          class="filtro-btn font-display font-500 text-sm px-4 py-1.5 rounded-full border transition-all"
          data-cat={cat.id}
          aria-pressed={cat.id === 'todos' ? 'true' : 'false'}
          style="border-color: var(--color-base-border); color: var(--color-muted);"
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Grid -->
    <div id="acertijos-grid" class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {ordenados.map((acertijo, i) => (
        <div data-categoria={acertijo.data.categoria} class="acertijo-item">
          <AcertijoCard acertijo={acertijo} index={i} />
        </div>
      ))}
    </div>

    <!-- Empty state -->
    <div id="empty-state" class="hidden text-center py-24">
      <p
        class="font-serif text-2xl italic"
        style="color: var(--color-muted);"
      >
        Ningún acertijo en esta categoría… por ahora.
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .filtro-btn[aria-pressed="true"] {
    border-color: var(--color-ink) !important;
    color: var(--color-base) !important;
    background: var(--color-ink);
  }
  .filtro-btn:hover:not([aria-pressed="true"]) {
    border-color: var(--color-ink-soft);
    color: var(--color-ink-soft);
    background: var(--color-base-soft);
  }
</style>

<script>
  function initFiltros() {
    const botones = document.querySelectorAll<HTMLButtonElement>('.filtro-btn');
    const items   = document.querySelectorAll<HTMLElement>('.acertijo-item');
    const empty   = document.getElementById('empty-state');
    const btnRandom = document.getElementById('btn-random') as HTMLAnchorElement | null;

    function filtrar(categoria: string) {
      let visibles = 0;
      items.forEach(item => {
        const visible = categoria === 'todos' || item.dataset.categoria === categoria;
        item.style.display = visible ? '' : 'none';
        if (visible) visibles++;
      });
      if (empty) empty.classList.toggle('hidden', visibles > 0);

      if (btnRandom) {
        const slugsVisibles = Array.from(items)
          .filter(el => el.style.display !== 'none')
          .map(el => el.querySelector('a')?.getAttribute('href') ?? '')
          .filter(Boolean);
        if (slugsVisibles.length > 0) {
          btnRandom.href = slugsVisibles[Math.floor(Math.random() * slugsVisibles.length)];
        }
      }
    }

    botones.forEach(btn => {
      btn.addEventListener('click', () => {
        botones.forEach(b => {
          b.setAttribute('aria-pressed', 'false');
          (b as HTMLElement).style.removeProperty('background');
        });
        btn.setAttribute('aria-pressed', 'true');
        filtrar(btn.dataset.cat ?? 'todos');
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltros);
</script>
