---
import Layout from "../layouts/Layout.astro";
import AcertijoCard from "../components/AcertijoCard.astro";
import Icono from "../components/Icono.astro";
import { getCollection } from "astro:content";
import { CATEGORIA_INFO } from "../lib/acertijos";

const acertijos = (await getCollection("acertijos")).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);
const categorias = Object.entries(CATEGORIA_INFO);
---

<Layout title="Elige un enigma">
  <main transition:name="pagina-contenido">
    <section class="container cabecera-jugar">
      <p class="kicker">{acertijos.length} enigmas y subiendo</p>
      <div class="cabecera-jugar-fila">
        <h1 class="titulo-jugar">Elige tu próximo enigma</h1>
        <button type="button" id="boton-aleatorio" class="boton-aleatorio">
          <Icono nombre="dado" />
          Sorpréndeme
        </button>
      </div>

      <div class="filtros" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="chip activo" data-filtro="todas">Todas</button>
        {
          categorias.map(([clave, info]) => (
            <button type="button" class="chip" data-filtro={clave} data-categoria={clave}>
              <Icono nombre={info.icono as any} class="chip-icono" />
              {info.label}
            </button>
          ))
        }
      </div>
    </section>

    <section class="container">
      <div class="grid-acertijos" id="grid-acertijos">
        {
          acertijos.map((acertijo) => (
            <div class="celda" data-categoria-item={acertijo.data.categoria}>
              <AcertijoCard acertijo={acertijo} />
            </div>
          ))
        }
      </div>
      <p id="sin-resultados" class="sin-resultados" hidden>
        No hay enigmas en esta categoría todavía. Vuelve pronto.
      </p>
    </section>
  </main>
</Layout>

<script>
  const slugs = Array.from(
    document.querySelectorAll<HTMLElement>("#grid-acertijos .celda"),
  ).map((celda) => celda.querySelector("a")?.getAttribute("href")).filter(Boolean) as string[];

  function inicializarFiltros() {
    const chips = document.querySelectorAll<HTMLButtonElement>(".chip");
    const celdas = document.querySelectorAll<HTMLElement>("#grid-acertijos .celda");
    const sinResultados = document.getElementById("sin-resultados");

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        chips.forEach((c) => c.classList.remove("activo"));
        chip.classList.add("activo");
        const filtro = chip.dataset.filtro;
        let visibles = 0;
        celdas.forEach((celda) => {
          const coincide = filtro === "todas" || celda.dataset.categoriaItem === filtro;
          celda.style.display = coincide ? "" : "none";
          if (coincide) visibles++;
        });
        if (sinResultados) sinResultados.hidden = visibles > 0;
      });
    });

    const botonAleatorio = document.getElementById("boton-aleatorio");
    botonAleatorio?.addEventListener("click", () => {
      if (slugs.length === 0) return;
      const destino = slugs[Math.floor(Math.random() * slugs.length)];
      window.location.href = destino;
    });
  }

  inicializarFiltros();
  document.addEventListener("astro:after-swap", inicializarFiltros);
</script>

<style>
  .cabecera-jugar {
    padding-block: 3rem 1.5rem;
  }
  .cabecera-jugar-fila {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block: 0.3rem 1.6rem;
  }
  .titulo-jugar {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
  }
  .boton-aleatorio {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    padding: 0.75rem 1.3rem;
    border-radius: 999px;
    border: 2.5px solid var(--color-tinta);
    background: #b5502f;
    color: var(--color-papel);
    cursor: pointer;
    transition: transform 0.2s ease;
  }
  .boton-aleatorio:hover {
    transform: translateY(-2px) rotate(-1deg);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 2px solid var(--color-tinta);
    background: transparent;
    color: var(--color-tinta);
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .chip-icono {
    width: 1em;
    height: 1em;
  }
  .chip[data-categoria] {
    color: var(--acento-tinta, var(--color-tinta));
  }
  .chip.activo,
  .chip:hover {
    background: var(--color-tinta);
    color: var(--color-papel);
  }

  .grid-acertijos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2rem 1.6rem;
    padding-block: 1rem 4rem;
  }
  .sin-resultados {
    text-align: center;
    padding-block: 3rem;
    color: var(--color-tinta-suave);
  }
</style>
