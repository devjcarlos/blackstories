---
import Layout from "../layouts/Layout.astro";
import AcertijoCard from "../components/AcertijoCard.astro";
import Icono from "../components/Icono.astro";
import { getCollection } from "astro:content";

const acertijos = await getCollection("acertijos");
const destacados = acertijos.filter((a) => a.data.destacado);
const rotaciones = [-2.2, 1.6, -1.2, 2, -1.6, 1.2];
---

<Layout title="Enigmas para jugar en grupo">
  <main transition:name="pagina-contenido">
    <section class="hero container">
      <div class="hero-texto">
        <p class="kicker">Juego de fiesta &middot; solo sí o no</p>
        <h1 class="hero-titulo">
          Alguien conoce
          <span class="subrayado-vivo">la verdad.</span>
          <br />
          Los demás solo pueden preguntar.
        </h1>
        <p class="hero-descripcion">
          Historias Negras es la versión digital de los enigmas de deducción tipo
          <em>Black Stories</em>: una persona lee una situación imposible y guarda la
          solución en secreto. El resto del grupo intenta reconstruirla haciendo
          preguntas que solo se pueden responder con <strong>sí</strong> o
          <strong>no</strong>. Cuanto más absurdo el enigma, mejor la noche.
        </p>
        <div class="hero-cta">
          <a href="/jugar" class="boton boton-primario">Elegir un enigma</a>
          <a href="/como-jugar" class="boton boton-secundario">Cómo se juega</a>
        </div>
      </div>
      <div class="hero-imagen">
        <img src="/images/hero.svg" alt="Un grupo de amigos alrededor de una mesa, con una carta de interrogación en el centro" width="640" height="640" />
      </div>
    </section>

    <section class="reglas container" aria-labelledby="reglas-titulo">
      <p class="kicker">En tres pasos</p>
      <h2 id="reglas-titulo" class="seccion-titulo">Cómo se juega</h2>
      <ol class="pasos">
        <li class="paso">
          <span class="paso-numero">01</span>
          <h3>Uno hace de Game Master</h3>
          <p>Elige un enigma y lee en voz alta solo el enunciado. La solución la ve únicamente él, en pantalla.</p>
        </li>
        <li class="paso">
          <span class="paso-numero">02</span>
          <h3>El resto pregunta</h3>
          <p>Solo valen preguntas cerradas: "¿Estaba solo?", "¿Fue un accidente?". El Game Master responde sí, no, o "no es relevante".</p>
        </li>
        <li class="paso">
          <span class="paso-numero">03</span>
          <h3>Se reconstruye la verdad</h3>
          <p>Cuando el grupo cree tenerlo, lo cuenta en voz alta. Gana quien se acerque más a la solución real.</p>
        </li>
      </ol>
    </section>

    {destacados.length > 0 && (
      <section class="destacados container" aria-labelledby="destacados-titulo">
        <p class="kicker">La mesa de esta semana</p>
        <h2 id="destacados-titulo" class="seccion-titulo">Enigmas destacados</h2>
        <div class="destacados-grid">
          {destacados.map((acertijo, i) => (
            <AcertijoCard acertijo={acertijo} rotacion={rotaciones[i % rotaciones.length]} />
          ))}
        </div>
        <a href="/jugar" class="ver-todos">
          Ver todos los enigmas <Icono nombre="flecha" />
        </a>
      </section>
    )}
  </main>
</Layout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-block: 3rem 4rem;
    align-items: center;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 1.1fr 0.9fr;
      padding-block: 4.5rem 5rem;
    }
  }
  .hero-titulo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.08;
    margin-block: 0.6rem 1.3rem;
    letter-spacing: -0.01em;
  }
  .hero-descripcion {
    font-family: var(--font-relato);
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-tinta-suave);
    max-width: 52ch;
  }
  .hero-cta {
    display: flex;
    gap: 1rem;
    margin-top: 1.8rem;
    flex-wrap: wrap;
  }
  .hero-imagen {
    position: relative;
  }
  .hero-imagen img {
    width: 100%;
    height: auto;
    max-width: 480px;
    margin-inline: auto;
    display: block;
  }
  @media (min-width: 900px) {
    .hero-imagen {
      margin-left: -2.5rem;
    }
  }

  .boton {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.82rem;
    padding: 0.85rem 1.5rem;
    border-radius: 999px;
    text-decoration: none;
    border: 2.5px solid var(--color-tinta);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .boton-primario {
    background: var(--color-tinta);
    color: var(--color-papel);
  }
  .boton-primario:hover {
    transform: translateY(-2px);
    background: #35302b;
  }
  .boton-secundario {
    background: transparent;
    color: var(--color-tinta);
  }
  .boton-secundario:hover {
    transform: translateY(-2px);
    background: var(--color-papel-oscuro);
  }

  .seccion-titulo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
    margin-block: 0.3rem 2rem;
  }

  .reglas {
    padding-block: 3rem;
    border-top: 2px dashed var(--color-borde);
  }
  .pasos {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    list-style: none;
  }
  @media (min-width: 800px) {
    .pasos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .paso-numero {
    display: block;
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: 2.4rem;
    color: #b5502f;
    line-height: 1;
    margin-bottom: 0.4rem;
  }
  .paso h3 {
    font-family: var(--font-label);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin-bottom: 0.5rem;
  }
  .paso p {
    color: var(--color-tinta-suave);
    line-height: 1.55;
    font-size: 0.95rem;
  }

  .destacados {
    padding-block: 2rem 4rem;
    border-top: 2px dashed var(--color-borde);
  }
  .destacados-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 2.4rem 1.6rem;
    padding-block: 1rem 2.5rem;
  }
  .ver-todos {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-decoration: none;
    color: var(--color-tinta);
  }
  .ver-todos :global(svg) {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.2s ease;
  }
  .ver-todos:hover :global(svg) {
    transform: translateX(4px);
  }
</style>
