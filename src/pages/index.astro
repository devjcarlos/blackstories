---
import BaseLayout from '../layouts/BaseLayout.astro';
import AcertijoCard from '../components/AcertijoCard.astro';
import { getCollection } from 'astro:content';

const all        = await getCollection('acertijos');
const destacados = all.filter(a => a.data.destacado).slice(0, 3);
---

<BaseLayout>

  <!-- ══════════════════════════════════════════════════════════
       HERO
  ══════════════════════════════════════════════════════════ -->
  <section class="hero container">

    <!-- Columna texto -->
    <div class="hero__text">
      <p class="eyebrow anim">El juego de fiesta · Sí o No</p>

      <h1 class="hero__title anim d1">
        Historias<br/>
        <em class="hero__title--red">Negras</em>
      </h1>

      <p class="hero__sub anim d2">
        Un enigma. Preguntas de sí&nbsp;o&nbsp;no.<br/>
        <em>Y una historia que nadie esperaba.</em>
      </p>

      <div class="hero__ctas anim d3">
        <a href="/jugar" class="btn btn--dark">
          Empezar a jugar
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/como-jugar" class="btn btn--outline">Cómo funciona</a>
      </div>
    </div>

    <!-- Columna imagen -->
    <div class="hero__img-wrap anim d2">
      <img
        src="/images/hero.svg"
        alt="Grupo jugando Historias Negras a la luz de una vela"
        class="hero__img"
        width="720"
        height="900"
      />
      <!-- Pill flotante sobre la imagen -->
      <div class="hero__pill">
        <span class="hero__pill-dot"></span>
        Más de 3 acertijos
      </div>
    </div>

  </section>

  <!-- ══════════════════════════════════════════════════════════
       CÓMO FUNCIONA
  ══════════════════════════════════════════════════════════ -->
  <section class="section container">
    <div class="divider"></div>

    <div class="section__head">
      <p class="eyebrow">Las reglas</p>
      <h2 class="section__title">Tres pasos, miles de historias</h2>
    </div>

    <div class="steps">
      {[
        { n:'01', title:'El Game Master lee el enigma',   body:'Solo él conoce la verdad. El resto del grupo escucha el misterioso enunciado.' },
        { n:'02', title:'El grupo pregunta',              body:'Las únicas respuestas posibles son "sí", "no" o "no es relevante".' },
        { n:'03', title:'Se revela la historia',          body:'Cuando alguien lo adivina, el Game Master descubre la solución completa.' },
      ].map((s, i) => (
        <div class={`step anim d${i+1}`}>
          <span class="step__num">{s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__body">{s.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════
       DESTACADOS
  ══════════════════════════════════════════════════════════ -->
  {destacados.length > 0 && (
    <section class="section container">
      <div class="divider"></div>

      <div class="section__head">
        <div>
          <p class="eyebrow">Para empezar</p>
          <h2 class="section__title">Acertijos destacados</h2>
        </div>
        <a href="/jugar" class="link-arrow">
          Ver todos
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>

      <div class="card-grid">
        {destacados.map((a, i) => <AcertijoCard acertijo={a} index={i} />)}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-top: 72px;
    padding-bottom: 80px;
  }
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 48px; }
    .hero__img-wrap { order: -1; }
  }

  .hero__text { display: flex; flex-direction: column; gap: 24px; }

  .hero__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(4rem, 9vw, 8rem);
    line-height: .9;
    letter-spacing: -.03em;
    color: var(--ink);
    font-style: normal;
  }
  .hero__title--red { color: var(--blood); font-style: normal; }

  .hero__sub {
    font-family: var(--f-serif);
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Imagen hero */
  .hero__img-wrap {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 4/5;
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Pill flotante */
  .hero__pill {
    position: absolute;
    bottom: 20px;
    left: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: color-mix(in srgb, var(--cream) 92%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid var(--cream-border);
    border-radius: 99px;
    padding: 8px 16px;
    font-family: var(--f-sans);
    font-size: .8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .hero__pill-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--blood);
    animation: blink-red 2s ease-in-out infinite;
  }

  /* ── Botones ──────────────────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 99px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .875rem;
    letter-spacing: .01em;
    text-decoration: none;
    transition: opacity .15s, scale .15s;
    cursor: pointer;
    border: none;
  }
  .btn:hover  { opacity: .85; }
  .btn:active { scale: .97; }

  .btn--dark    { background: var(--ink);  color: var(--cream); }
  .btn--outline {
    background: transparent;
    color: var(--ink-2);
    border: 1.5px solid var(--cream-border);
  }
  .btn--outline:hover { border-color: var(--ink-2); }

  /* ── Secciones ────────────────────────────────────────────── */
  .section { padding-bottom: 80px; }

  .divider {
    height: 1px;
    background: var(--cream-border);
    margin-bottom: 60px;
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 48px;
  }

  .eyebrow {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .15em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: 8px;
  }

  .section__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--ink);
    letter-spacing: -.02em;
    line-height: 1.1;
  }

  /* ── Steps ────────────────────────────────────────────────── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  @media (max-width: 640px) {
    .steps { grid-template-columns: 1fr; gap: 32px; }
  }

  .step { display: flex; flex-direction: column; gap: 12px; }

  .step__num {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 3.5rem;
    line-height: 1;
    color: var(--cream-border);
  }

  .step__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--ink);
    line-height: 1.3;
  }

  .step__body {
    font-size: .9rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ── Card grid ────────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }

  /* ── Link con flecha ──────────────────────────────────────── */
  .link-arrow {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--f-sans);
    font-size: .875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color .15s;
  }
  .link-arrow:hover { color: var(--ink); }
  .link-arrow svg { transition: translate .15s; }
  .link-arrow:hover svg { translate: 3px 0; }
</style>
