---
import BaseLayout from '../layouts/BaseLayout.astro';
import AcertijoCard from '../components/AcertijoCard.astro';
import { getCollection } from 'astro:content';

const all        = await getCollection('acertijos');
const destacados = all.filter(a => a.data.destacado).slice(0, 3);
---

<BaseLayout>

  <!-- ══ HERO ═══════════════════════════════════════════════════ -->
  <section class="hero container">
    <div class="hero__text">
      <p class="eyebrow anim">El juego de fiesta · Sí o No</p>
      <h1 class="hero__title anim d1">
        Historias<br/>
        <span class="hero__red">Negras</span>
      </h1>
      <p class="hero__sub anim d2">
        Un enigma. Preguntas de sí&nbsp;o&nbsp;no.<br/>
        <em>Y una historia que nadie esperaba.</em>
      </p>
      <div class="hero__ctas anim d3">
        <a href="/jugar"       class="btn btn--dark">Empezar a jugar →</a>
        <a href="/como-jugar"  class="btn btn--outline">Cómo funciona</a>
      </div>
    </div>

    <div class="hero__media anim d2">
      <img
        src="/images/hero.svg"
        alt="Grupo jugando Historias Negras a la luz de una vela"
        class="hero__img"
        width="720" height="900"
      />
      <div class="hero__pill">
        <span class="hero__dot"></span>
        {all.length} acertijos disponibles
      </div>
    </div>
  </section>

  <!-- ══ CÓMO FUNCIONA ══════════════════════════════════════════ -->
  <section class="section container">
    <div class="section__hr"></div>
    <p class="eyebrow">Las reglas</p>
    <h2 class="section__h2 anim">Tres pasos, miles de historias</h2>
    <div class="steps">
      {[
        { n:'01', t:'El Game Master lee el enigma',  b:'Solo él conoce la verdad. Lee el enunciado misterioso en voz alta.' },
        { n:'02', t:'El grupo pregunta',             b:'"Sí", "no" o "no es relevante". Sin más pistas.' },
        { n:'03', t:'Se revela la historia',         b:'Cuando alguien lo adivina, el Game Master descubre la solución.' },
      ].map((s, i) => (
        <div class={`step anim d${i+1}`}>
          <span class="step__n">{s.n}</span>
          <h3 class="step__t">{s.t}</h3>
          <p class="step__b">{s.b}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ══ DESTACADOS ═════════════════════════════════════════════ -->
  {destacados.length > 0 && (
    <section class="section container">
      <div class="section__hr"></div>
      <div class="section__head">
        <div>
          <p class="eyebrow">Para empezar</p>
          <h2 class="section__h2">Acertijos destacados</h2>
        </div>
        <a href="/jugar" class="ver-todos">
          Ver todos
          <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="card-grid">
        {destacados.map((a, i) => <AcertijoCard acertijo={a} index={i} />)}
      </div>
    </section>
  )}

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
    padding-top: 80px;
    padding-bottom: 96px;
  }
  @media (max-width: 780px) {
    .hero { grid-template-columns: 1fr; gap: 40px; padding-top: 48px; padding-bottom: 64px; }
    .hero__media { order: -1; }
  }

  .hero__text { display: flex; flex-direction: column; gap: 28px; }

  .hero__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: .9;
    letter-spacing: -.03em;
    color: var(--ink);
  }
  .hero__red { color: var(--blood); }

  .hero__sub {
    font-family: var(--f-serif);
    font-size: 1.2rem;
    line-height: 1.65;
    color: var(--muted);
  }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  /* Imagen */
  .hero__media {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 3/4;
    background: var(--ink);
  }
  .hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Pill flotante */
  .hero__pill {
    position: absolute;
    bottom: 16px;
    left: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(243,237,227,0.9);
    backdrop-filter: blur(10px);
    border: 1px solid var(--cream-border);
    border-radius: 99px;
    padding: 7px 14px;
    font-family: var(--f-sans);
    font-size: .8125rem;
    font-weight: 500;
    color: var(--ink-2);
  }
  .hero__dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: var(--blood);
    animation: blink-red 2s ease-in-out infinite;
  }

  /* ── Secciones ────────────────────────────────────────────── */
  .section { padding-bottom: 96px; }

  .section__hr {
    height: 1px;
    background: var(--cream-border);
    margin-bottom: 48px;
  }

  .section__h2 {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    color: var(--ink);
    letter-spacing: -.02em;
    line-height: 1.1;
    margin-top: 10px;
    margin-bottom: 48px;
  }

  .section__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 32px;
  }
  .section__head .section__h2 { margin-bottom: 0; }

  /* ── Steps ────────────────────────────────────────────────── */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
  }
  @media (max-width: 640px) { .steps { grid-template-columns: 1fr; gap: 32px; } }

  .step { display: flex; flex-direction: column; gap: 12px; }

  .step__n {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 3rem;
    line-height: 1;
    color: var(--cream-border);
  }
  .step__t {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    line-height: 1.35;
  }
  .step__b {
    font-size: .9rem;
    line-height: 1.65;
    color: var(--muted);
  }

  /* ── Card grid ────────────────────────────────────────────── */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) { .card-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .card-grid { grid-template-columns: 1fr; } }

  /* ── Ver todos ────────────────────────────────────────────── */
  .ver-todos {
    display: flex;
    align-items: center;
    gap: 4px;
    font-family: var(--f-sans);
    font-size: .875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color .15s;
    padding-bottom: 4px;
  }
  .ver-todos:hover { color: var(--ink); }
  .ver-todos:hover svg { translate: 3px 0; }
  .ver-todos svg { transition: translate .15s; }
</style>
