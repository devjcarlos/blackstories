---
interface Props { tiempoEstimado?: number; }
const { tiempoEstimado = 15 } = Astro.props;
---

<div class="timer" data-limite={tiempoEstimado * 60}>
  <span id="timer-display" class="timer__display">00:00</span>
  <div class="timer__controls">
    <button id="timer-toggle" class="timer__btn timer__btn--play" aria-label="Iniciar/Pausar">
      <svg id="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
        <path d="M8 5v14l11-7L8 5z"/>
      </svg>
      <svg id="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display:none">
        <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
      </svg>
    </button>
    <button id="timer-reset" class="timer__btn timer__btn--reset" aria-label="Reiniciar">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
        <path d="M3 3v5h5"/>
      </svg>
    </button>
  </div>
</div>

<style>
  .timer {
    display: flex;
    align-items: center;
    gap: 14px;
    user-select: none;
  }

  .timer__display {
    font-family: 'Inter', monospace;
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -.01em;
    color: var(--ink);
    tabular-nums: true;
    font-variant-numeric: tabular-nums;
    transition: color .4s;
    min-width: 5ch;
  }

  .timer__controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .timer__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--cream-border);
    background: var(--cream);
    color: var(--ink-2);
    cursor: pointer;
    transition: background .15s, border-color .15s, color .15s, scale .1s;
    border-radius: 50%;
  }
  .timer__btn:hover { background: var(--cream-2); border-color: var(--ink-2); color: var(--ink); }
  .timer__btn:active { scale: .93; }

  .timer__btn--play  { width: 40px; height: 40px; }
  .timer__btn--reset { width: 32px; height: 32px; color: var(--muted); }
</style>

<script define:vars={{ tiempoEstimado }}>
  function initTimer() {
    const display   = document.getElementById('timer-display');
    const btnToggle = document.getElementById('timer-toggle');
    const btnReset  = document.getElementById('timer-reset');
    const iconPlay  = document.getElementById('icon-play');
    const iconPause = document.getElementById('icon-pause');

    if (!display || !btnToggle) return;

    const limite = tiempoEstimado * 60;
    let seg = 0, running = false, iv = null;

    const fmt = s => `${String(Math.floor(s/60)).padStart(2,'0')}:${String(s%60).padStart(2,'0')}`;

    function update() {
      display.textContent = fmt(seg);
      const urgent = seg >= limite;
      display.classList.toggle('timer-urgent', urgent);
    }

    function toggle() {
      running = !running;
      if (running) {
        iv = setInterval(() => { seg++; update(); }, 1000);
        iconPlay.style.display  = 'none';
        iconPause.style.display = '';
      } else {
        clearInterval(iv);
        iconPlay.style.display  = '';
        iconPause.style.display = 'none';
      }
    }

    function reset() {
      running = false; clearInterval(iv); seg = 0;
      iconPlay.style.display  = '';
      iconPause.style.display = 'none';
      update();
    }

    btnToggle.addEventListener('click', toggle);
    btnReset?.addEventListener('click', reset);
    document.addEventListener('astro:before-preparation', reset);
    update();
  }

  document.addEventListener('astro:page-load', initTimer);
</script>
