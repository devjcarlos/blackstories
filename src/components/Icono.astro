---
export type NombreIcono =
  | "reloj"
  | "dado"
  | "flecha"
  | "candado"
  | "sello"
  | "luna" // oscuro
  | "espiral" // surreal
  | "mascara" // humor
  | "libro" // clasico
  | "corona" // historico
  | "rayo" // cortito
  | "ojo";

interface Props {
  nombre: NombreIcono;
  class?: string;
}

const { nombre, class: className = "" } = Astro.props;
---

<svg
  class={`icono-linea ${className}`}
  viewBox="0 0 32 32"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    nombre === "reloj" && (
      <>
        <circle cx="16" cy="17" r="10.5" />
        <path d="M16 11v6l4.5 3" />
        <path d="M12 3.5h8" />
      </>
    )
  }
  {
    nombre === "dado" && (
      <>
        <rect x="6" y="6" width="20" height="20" rx="5" />
        <circle cx="12" cy="12" r="1.3" fill="currentColor" />
        <circle cx="20" cy="12" r="1.3" fill="currentColor" />
        <circle cx="16" cy="16" r="1.3" fill="currentColor" />
        <circle cx="12" cy="20" r="1.3" fill="currentColor" />
        <circle cx="20" cy="20" r="1.3" fill="currentColor" />
      </>
    )
  }
  {
    nombre === "flecha" && (
      <>
        <path d="M7 16h18" />
        <path d="M17 8l8 8-8 8" />
      </>
    )
  }
  {
    nombre === "candado" && (
      <>
        <rect x="7" y="14" width="18" height="13" rx="3" />
        <path d="M11 14v-3a5 5 0 0 1 10 0v3" />
        <path d="M16 19v3" />
      </>
    )
  }
  {
    nombre === "sello" && (
      <>
        <path d="M16 4c-3.3 0-6 2.9-6 6.4 0 3.6 2.7 5.2 6 9.6 3.3-4.4 6-6 6-9.6C22 6.9 19.3 4 16 4Z" />
        <path d="M11 22.5 8 28l8-3 8 3-3-5.5" />
      </>
    )
  }
  {
    nombre === "luna" && (
      <path d="M21.5 6a11 11 0 1 0 4.5 15.6A9 9 0 0 1 21.5 6Z" />
    )
  }
  {
    nombre === "espiral" && (
      <path d="M16 22a6 6 0 1 1 4-10.5M16 22a10 10 0 1 1 7-17.2M16 22a2 2 0 1 1 1-3.7" />
    )
  }
  {
    nombre === "mascara" && (
      <>
        <path d="M5 12c3-4 8-6 11-6s8 2 11 6c0 8-5 14-11 14S5 20 5 12Z" />
        <path d="M11 14v1.5M21 14v1.5" />
        <path d="M12 20c1.3 1 2.7 1 4 1s2.7 0 4-1" />
      </>
    )
  }
  {
    nombre === "libro" && (
      <>
        <path d="M16 8c-2.5-2-6-2.5-10-1.8v17c4-.7 7.5-.2 10 1.8" />
        <path d="M16 8c2.5-2 6-2.5 10-1.8v17c-4-.7-7.5-.2-10 1.8" />
        <path d="M16 8v17" />
      </>
    )
  }
  {
    nombre === "corona" && (
      <path d="M5 24 4 12l6 5 6-9 6 9 6-5-1 12Z" />
    )
  }
  {
    nombre === "rayo" && <path d="M18 4 8 18h7l-1 10 12-16h-8Z" />}
  {
    nombre === "ojo" && (
      <>
        <path d="M4 16s5-8 12-8 12 8 12 8-5 8-12 8-12-8-12-8Z" />
        <circle cx="16" cy="16" r="3.4" />
      </>
    )
  }
</svg>

<style>
  .icono-linea {
    width: 1.4em;
    height: 1.4em;
    flex-shrink: 0;
  }
</style>
