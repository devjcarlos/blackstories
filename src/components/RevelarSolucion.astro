---
import Icono from "./Icono.astro";

interface Props {
  solucionHtml: string;
}
const { solucionHtml } = Astro.props;
---

<div class="revelar" data-revelar data-estado="oculto">
  <div class="panel panel-oculto" data-panel="oculto">
    <Icono nombre="sello" class="sello" />
    <p class="panel-texto">
      La solución está sellada. Solo debería verla quien hace de <strong>Game Master</strong>.
    </p>
    <button type="button" class="boton-revelar" data-accion="pedir-confirmacion">
      Soy el Game Master, mostrar solución
    </button>
  </div>

  <div class="panel panel-confirmar" data-panel="confirmar" hidden>
    <Icono nombre="candado" class="sello" />
    <p class="panel-texto">
      ¿Seguro? Si los demás jugadores están mirando la pantalla, van a ver la
      respuesta y se arruina la partida.
    </p>
    <div class="panel-botones">
      <button type="button" class="boton-revelar" data-accion="confirmar">
        Sí, solo yo estoy mirando
      </button>
      <button type="button" class="boton-cancelar" data-accion="cancelar">Cancelar</button>
    </div>
  </div>

  <div class="panel panel-rompiendo" data-panel="rompiendo" hidden aria-hidden="true">
    <div class="grieta-escena">
      <svg class="grieta-mitad grieta-mitad--izq" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 4c-3.3 0-6 2.9-6 6.4 0 3.6 2.7 5.2 6 9.6 3.3-4.4 6-6 6-9.6C22 6.9 19.3 4 16 4Z" />
        <path d="M11 22.5 8 28l8-3 8 3-3-5.5" />
      </svg>
      <svg class="grieta-mitad grieta-mitad--der" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 4c-3.3 0-6 2.9-6 6.4 0 3.6 2.7 5.2 6 9.6 3.3-4.4 6-6 6-9.6C22 6.9 19.3 4 16 4Z" />
        <path d="M11 22.5 8 28l8-3 8 3-3-5.5" />
      </svg>
    </div>
    <p class="panel-texto panel-texto--rompiendo">Rompiendo el sello…</p>
  </div>

  <div class="panel panel-revelado" data-panel="revelado" hidden>
    <p class="kicker">La solución</p>
    <div class="solucion-texto" set:html={solucionHtml} />
    <button type="button" class="boton-ocultar" data-accion="ocultar">
      Ocultar otra vez
    </button>
  </div>
</div>

<script>
  const SIN_MOVIMIENTO = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const DURACION_ROTURA = 520;

  function inicializarRevelar() {
    document.querySelectorAll<HTMLElement>("[data-revelar]").forEach((raiz) => {
      if (raiz.dataset.listo === "true") return;
      raiz.dataset.listo = "true";

      const paneles = {
        oculto: raiz.querySelector<HTMLElement>('[data-panel="oculto"]')!,
        confirmar: raiz.querySelector<HTMLElement>('[data-panel="confirmar"]')!,
        rompiendo: raiz.querySelector<HTMLElement>('[data-panel="rompiendo"]')!,
        revelado: raiz.querySelector<HTMLElement>('[data-panel="revelado"]')!,
      };

      let temporizador: ReturnType<typeof setTimeout> | null = null;

      const mostrar = (estado: keyof typeof paneles) => {
        raiz.dataset.estado = estado;
        Object.entries(paneles).forEach(([clave, el]) => {
          el.hidden = clave !== estado;
        });
      };

      raiz.querySelector('[data-accion="pedir-confirmacion"]')?.addEventListener("click", () => mostrar("confirmar"));
      raiz.querySelector('[data-accion="cancelar"]')?.addEventListener("click", () => mostrar("oculto"));
      raiz.querySelector('[data-accion="ocultar"]')?.addEventListener("click", () => {
        if (temporizador) clearTimeout(temporizador);
        mostrar("oculto");
      });

      raiz.querySelector('[data-accion="confirmar"]')?.addEventListener("click", () => {
        if (SIN_MOVIMIENTO()) {
          mostrar("revelado");
          return;
        }
        mostrar("rompiendo");
        temporizador = setTimeout(() => mostrar("revelado"), DURACION_ROTURA);
      });
    });
  }

  inicializarRevelar();
  document.addEventListener("astro:after-swap", inicializarRevelar);
</script>

<style>
  .revelar {
    border: 2.5px solid var(--color-tinta);
    border-radius: var(--radio-tarjeta);
    background: var(--acento-suave);
    padding: 2rem 1.6rem;
    text-align: center;
    margin-block: 2.5rem;
    overflow: hidden;
  }
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .sello {
    width: 2.4rem;
    height: 2.4rem;
    color: var(--acento);
  }
  .panel-texto {
    max-width: 46ch;
    font-family: var(--font-ui);
    font-size: 0.95rem;
    color: var(--color-tinta-suave);
  }
  .panel-texto--rompiendo {
    font-weight: 600;
    color: var(--acento-tinta);
    letter-spacing: 0.02em;
  }
  .panel-botones {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  .boton-revelar,
  .boton-cancelar,
  .boton-ocultar {
    font-family: var(--font-label);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    padding: 0.8rem 1.4rem;
    border-radius: 999px;
    cursor: pointer;
    border: 2.5px solid var(--color-tinta);
  }
  .boton-revelar {
    background: var(--color-tinta);
    color: var(--color-papel);
  }
  .boton-cancelar,
  .boton-ocultar {
    background: transparent;
    color: var(--color-tinta);
  }
  .solucion-texto {
    font-family: var(--font-relato);
    font-size: 1.15rem;
    line-height: 1.65;
    max-width: 56ch;
    text-align: left;
  }
  .solucion-texto :global(p) {
    margin-bottom: 0.9rem;
  }

  /* --- Animación: sello rompiéndose --- */
  .grieta-escena {
    position: relative;
    width: 3rem;
    height: 3.6rem;
    color: var(--acento);
  }
  .grieta-mitad {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .grieta-mitad--izq {
    clip-path: polygon(0 0, 51% 0, 51% 100%, 0 100%);
  }
  .grieta-mitad--der {
    clip-path: polygon(49% 0, 100% 0, 100% 100%, 49% 100%);
  }

  .panel-revelado {
    animation: hn-desplegar-solucion 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-estado="rompiendo"] .grieta-mitad--izq {
      animation: hn-romper-izq 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) forwards;
    }
    [data-estado="rompiendo"] .grieta-mitad--der {
      animation: hn-romper-der 0.5s cubic-bezier(0.36, 0.07, 0.19, 0.97) forwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel-revelado {
      animation: none;
    }
  }

  @keyframes hn-romper-izq {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(-14px, 10px) rotate(-22deg);
      opacity: 0;
    }
  }
  @keyframes hn-romper-der {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 1;
    }
    100% {
      transform: translate(14px, 10px) rotate(22deg);
      opacity: 0;
    }
  }
  @keyframes hn-desplegar-solucion {
    from {
      opacity: 0;
      transform: translateY(-16px) scaleY(0.96);
      transform-origin: top center;
    }
    to {
      opacity: 1;
      transform: translateY(0) scaleY(1);
    }
  }
</style>
