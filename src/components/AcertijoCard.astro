---
import type { CollectionEntry } from 'astro:content';

interface Props {
  acertijo: CollectionEntry<'acertijos'>;
  index?: number;
}

const { acertijo, index = 0 } = Astro.props;
const { title, dificultad, categoria, tiempoEstimado, imagen } = acertijo.data;
const slug = acertijo.id;
const staggerClass = `stagger-${Math.min(index + 1, 8)}`;

const categoriaLabel: Record<string, string> = {
  clasico:   'Clásico',
  oscuro:    'Oscuro',
  humor:     'Humor',
  historico: 'Histórico',
  cortito:   'Cortito',
  surreal:   'Surreal',
};

// Extrae preview del enunciado
const enunciado = acertijo.body.split('<!-- SOLUCIÓN -->')[0].trim();
const preview = enunciado.length > 120 ? enunciado.slice(0, 117) + '…' : enunciado;

const esOscuro = categoria === 'oscuro';
---

<a
  href={`/acertijos/${slug}`}
  data-theme={categoria}
  class={`card group block rounded-2xl overflow-hidden animate-fade-up ${staggerClass} transition-all duration-300 hover:-translate-y-1`}
  style={`
    background: var(--cat-bg);
    border: 1.5px solid var(--cat-border);
    box-shadow: 0 2px 8px rgba(0,0,0,${esOscuro ? '0.4' : '0.06'});
  `}
>
  <!-- Imagen -->
  <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
    {imagen ? (
      <img
        src={imagen}
        alt={title}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        style={`view-transition-name: imagen-${slug}`}
        loading="lazy"
      />
    ) : (
      <div
        class="w-full h-full flex items-center justify-center"
        style={`
          view-transition-name: imagen-${slug};
          background: linear-gradient(135deg, var(--cat-border) 0%, var(--cat-bg) 100%);
        `}
      >
        <svg viewBox="0 0 120 80" class="w-20 opacity-30" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="60" cy="35" r="20" stroke="currentColor" stroke-width="1.5" style={`color: var(--cat-accent)`}/>
          <path d="M40 65 Q60 50 80 65" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style={`color: var(--cat-accent)`}/>
          <line x1="60" y1="15" x2="60" y2="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style={`color: var(--cat-muted)`}/>
          <line x1="60" y1="55" x2="60" y2="62" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style={`color: var(--cat-muted)`}/>
          <line x1="40" y1="35" x2="33" y2="35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style={`color: var(--cat-muted)`}/>
          <line x1="80" y1="35" x2="87" y2="35" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" style={`color: var(--cat-muted)`}/>
        </svg>
      </div>
    )}

    <!-- Badge categoría — esquina superior izquierda -->
    <div class="absolute top-3 left-3">
      <span
        class="text-xs font-display font-600 px-2.5 py-1 rounded-full uppercase tracking-wide"
        style={`
          background: var(--cat-accent);
          color: ${esOscuro ? '#f8ece8' : '#fff'};
          letter-spacing: 0.06em;
        `}
      >
        {categoriaLabel[categoria]}
      </span>
    </div>
  </div>

  <!-- Contenido -->
  <div class="p-5 flex flex-col gap-3">

    <!-- Título -->
    <h2
      class="font-display font-700 text-xl leading-tight transition-colors"
      style={`
        color: var(--cat-text);
        view-transition-name: titulo-${slug};
      `}
    >
      {title}
    </h2>

    <!-- Preview enunciado -->
    <p
      class="font-serif text-sm leading-relaxed line-clamp-2 italic"
      style="color: var(--cat-muted); font-size: 0.95rem;"
    >
      {preview}
    </p>

    <!-- Footer: dificultad + tiempo -->
    <div class="flex items-center justify-between pt-1">
      <!-- Dificultad: 5 cuadraditos -->
      <div class="flex items-center gap-1.5">
        {Array.from({ length: 5 }).map((_, i) => (
          <span
            class="w-2 h-2 rounded-sm"
            style={`background: ${i < dificultad ? 'var(--cat-accent)' : 'var(--cat-border)'};`}
          />
        ))}
      </div>

      <!-- Tiempo -->
      <div class="flex items-center gap-1" style="color: var(--cat-muted);">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
          <path d="M12 6v6l4 2" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span class="text-xs">{tiempoEstimado} min</span>
      </div>
    </div>

  </div>

  <!-- Borde acento inferior — solo visible en hover -->
  <div
    class="h-0.5 w-0 group-hover:w-full transition-all duration-500"
    style="background: var(--cat-accent);"
  />
</a>
