---
import CategoriaTag from "./CategoriaTag.astro";
import DificultadDots from "./DificultadDots.astro";
import Icono from "./Icono.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  acertijo: CollectionEntry<"acertijos">;
  rotacion?: number;
  class?: string;
}

const { acertijo, rotacion = 0, class: className = "" } = Astro.props;
const { title, categoria, dificultad, tiempoEstimado, imagen } = acertijo.data;
---

<a
  href={`/acertijos/${acertijo.id}/`}
  class={`tarjeta ${className}`}
  data-categoria={categoria}
  style={rotacion ? `--rotacion: ${rotacion}deg` : undefined}
>
  <div class="tarjeta-imagen" transition:name={`imagen-${acertijo.id}`}>
    <img src={imagen} alt="" loading="lazy" width="640" height="480" />
  </div>
  <div class="tarjeta-cuerpo">
    <CategoriaTag categoria={categoria} />
    <h3 class="tarjeta-titulo" transition:name={`titulo-${acertijo.id}`}>{title}</h3>
    <div class="tarjeta-meta">
      <span class="meta-item"><Icono nombre="reloj" class="meta-icono" />{tiempoEstimado} min</span>
      <DificultadDots dificultad={dificultad} />
    </div>
  </div>
</a>

<style>
  .tarjeta {
    display: block;
    background: var(--color-papel);
    border: 2.5px solid var(--color-tinta);
    border-radius: var(--radio-tarjeta);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transform: rotate(var(--rotacion, 0deg));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.35s ease;
    box-shadow: var(--sombra-tarjeta);
  }
  .tarjeta:hover,
  .tarjeta:focus-visible {
    transform: rotate(0deg) translateY(-4px);
    box-shadow: 0 4px 8px rgba(28, 25, 23, 0.08), 0 22px 34px -16px rgba(28, 25, 23, 0.28);
  }
  .tarjeta-imagen {
    aspect-ratio: 4 / 3;
    border-bottom: 2.5px solid var(--color-tinta);
    background: var(--acento-suave);
    overflow: hidden;
  }
  .tarjeta-imagen img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .tarjeta-cuerpo {
    padding: 1.1rem 1.2rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .tarjeta-titulo {
    font-family: var(--font-headline);
    font-weight: 900;
    font-size: 1.28rem;
    line-height: 1.22;
  }
  .tarjeta-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-family: var(--font-ui);
    font-size: 0.78rem;
    color: var(--color-tinta-suave);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .meta-icono {
    width: 1em;
    height: 1em;
  }
</style>
