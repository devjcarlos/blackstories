---
import type { CollectionEntry } from 'astro:content';

interface Props {
  acertijo: CollectionEntry<'acertijos'>;
  index?: number;
}

const { acertijo, index = 0 } = Astro.props;
const { title, dificultad, categoria, tiempoEstimado, imagen } = acertijo.data;
const slug   = acertijo.id;
const delay  = `d${Math.min(index + 1, 6)}`;
const dark   = categoria === 'oscuro';

const labels: Record<string, string> = {
  oscuro: 'Oscuro', surreal: 'Surreal', humor: 'Humor',
  clasico: 'Clásico', historico: 'Histórico', cortito: 'Cortito',
};

const preview = (() => {
  const txt = acertijo.body.split('<!-- SOLUCIÓN -->')[0].trim();
  return txt.length > 110 ? txt.slice(0, 108) + '…' : txt;
})();
---

<a
  href={`/acertijos/${slug}`}
  data-cat={categoria}
  class={`card anim ${delay}`}
>
  <!-- Imagen / placeholder -->
  <div class="card__img-wrap">
    {imagen
      ? <img
          src={imagen}
          alt={title}
          class="card__img"
          style={`view-transition-name: img-${slug}`}
          loading="lazy"
        />
      : <div
          class="card__placeholder"
          style={`view-transition-name: img-${slug}`}
        >
          <svg viewBox="0 0 80 80" fill="none" class="card__placeholder-icon">
            <circle cx="40" cy="38" r="18" stroke="currentColor" stroke-width="1.2"/>
            <path d="M24 64 Q40 52 56 64" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="40" y1="20" x2="40" y2="14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="40" y1="56" x2="40" y2="62" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="22" y1="38" x2="16" y2="38" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            <line x1="58" y1="38" x2="64" y2="38" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          </svg>
        </div>
    }
    <!-- Badge -->
    <span class="card__badge">{labels[categoria]}</span>
  </div>

  <!-- Contenido -->
  <div class="card__body">
    <h2
      class="card__title"
      style={`view-transition-name: title-${slug}`}
    >{title}</h2>

    <p class="card__preview">{preview}</p>

    <div class="card__meta">
      <!-- Dificultad -->
      <div class="card__dots" aria-label={`Dificultad ${dificultad} de 5`}>
        {Array.from({length: 5}).map((_, i) => (
          <span class={`dot ${i < dificultad ? 'dot--on' : 'dot--off'}`}/>
        ))}
      </div>
      <!-- Tiempo -->
      <div class="card__time">
        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
          <path d="M12 6v6l4 2" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        {tiempoEstimado} min
      </div>
    </div>
  </div>

  <!-- Barra acento inferior (hover) -->
  <div class="card__accent-bar"></div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    border: 1.5px solid var(--border, var(--cream-border));
    background: var(--bg, var(--cream));
    transition: box-shadow .2s, translate .2s;
    position: relative;
  }
  .card:hover {
    box-shadow: 0 8px 32px color-mix(in srgb, var(--accent, var(--ink)) 12%, transparent);
    translate: 0 -3px;
  }

  /* ── Imagen ─────────────────────────────────────────────────── */
  .card__img-wrap {
    position: relative;
    aspect-ratio: 4/3;
    overflow: hidden;
  }

  .card__img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: scale .4s ease;
  }
  .card:hover .card__img { scale: 1.04; }

  .card__placeholder {
    width: 100%; height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--border, var(--cream-border)) 40%, var(--bg, var(--cream)));
  }

  .card__placeholder-icon {
    width: 52px; height: 52px;
    color: var(--accent, var(--muted));
    opacity: .35;
  }

  .card__badge {
    position: absolute;
    top: 12px; left: 12px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .6875rem;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--accent, var(--ink));
    color: #fff;
  }

  /* ── Body ────────────────────────────────────────────────────── */
  .card__body {
    padding: 18px 20px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.2;
    color: var(--tx, var(--ink));
    letter-spacing: -.01em;
  }

  .card__preview {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: .9375rem;
    line-height: 1.55;
    color: var(--mu, var(--muted));
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }

  .card__dots { display: flex; gap: 4px; align-items: center; }

  .dot {
    width: 7px; height: 7px;
    border-radius: 2px;
  }
  .dot--on  { background: var(--accent, var(--ink)); }
  .dot--off { background: var(--border, var(--cream-border)); }

  .card__time {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: .8125rem;
    color: var(--mu, var(--muted));
  }

  /* ── Barra acento ────────────────────────────────────────────── */
  .card__accent-bar {
    height: 3px;
    width: 0;
    background: var(--accent, var(--ink));
    transition: width .35s ease;
  }
  .card:hover .card__accent-bar { width: 100%; }
</style>
