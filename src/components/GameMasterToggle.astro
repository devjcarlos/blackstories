---
interface Props {
  solucion: string;
  categoria?: string;
}
const { solucion, categoria = 'clasico' } = Astro.props;
const dark = categoria === 'oscuro';
---

<div class="gm-wrap">

  <!-- Cortina (overlay que cubre la solución) -->
  <div
    id="gm-curtain"
    class="curtain gm-curtain"
    role="button"
    tabindex="0"
    aria-label="Revelar solución — solo para el Game Master"
  >
    <div class="gm-curtain__content">
      <div class="gm-curtain__icon">
        <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
      <p class="gm-curtain__label">Solución</p>
      <p class="gm-curtain__sub">Solo para el Game Master</p>
      <div class="gm-curtain__btn">Pulsa para revelar</div>
    </div>
  </div>

  <!-- Modal de confirmación -->
  <div id="gm-modal" class="gm-modal" role="dialog" aria-modal="true" hidden>
    <div id="gm-backdrop" class="gm-modal__backdrop"></div>
    <div class="gm-modal__card anim">
      <div class="gm-modal__icon">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>
      <h3 class="gm-modal__title">¿Eres el Game Master?</h3>
      <p class="gm-modal__body">
        La solución quedará visible en pantalla. Asegúrate de que los demás jugadores no estén mirando.
      </p>
      <div class="gm-modal__actions">
        <button id="gm-cancel"  class="gm-modal__cancel">Cancelar</button>
        <button id="gm-confirm" class="gm-modal__confirm">Soy el GM</button>
      </div>
    </div>
  </div>

  <!-- Solución (queda debajo del overlay) -->
  <div class="gm-solution">
    <p class="gm-solution__label">Solución</p>
    <p class="gm-solution__text">{solucion}</p>
  </div>

</div>

<style>
  .gm-wrap { position: relative; }

  /* ── Cortina ─────────────────────────────────────────────── */
  .gm-curtain {
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    background: var(--ink);
    transition: opacity .2s;
  }
  .gm-curtain:hover { opacity: .92; }

  .gm-curtain__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 24px;
    text-align: center;
    pointer-events: none;
  }

  .gm-curtain__icon {
    width: 52px; height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid rgba(255,255,255,.15);
    color: var(--blood);
    margin-bottom: 4px;
  }

  .gm-curtain__label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: rgba(255,255,255,.45);
  }

  .gm-curtain__sub {
    font-size: .8125rem;
    color: rgba(255,255,255,.25);
  }

  .gm-curtain__btn {
    margin-top: 8px;
    padding: 8px 20px;
    border-radius: 99px;
    border: 1.5px solid var(--blood);
    background: transparent;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .8125rem;
    letter-spacing: .04em;
    color: var(--blood);
  }

  /* ── Modal ────────────────────────────────────────────────── */
  .gm-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
  }
  .gm-modal[hidden] { display: none; }

  .gm-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,.65);
    backdrop-filter: blur(8px);
  }

  .gm-modal__card {
    position: relative;
    z-index: 1;
    background: var(--cream);
    border: 1.5px solid var(--cream-border);
    border-radius: 20px;
    padding: 36px 32px;
    max-width: 360px;
    width: 100%;
    text-align: center;
    box-shadow: 0 24px 60px rgba(0,0,0,.18);
  }

  .gm-modal__icon {
    width: 48px; height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--blood) 10%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--blood) 25%, transparent);
    color: var(--blood);
    margin: 0 auto 16px;
  }

  .gm-modal__title {
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.125rem;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .gm-modal__body {
    font-size: .9rem;
    line-height: 1.6;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .gm-modal__actions {
    display: flex;
    gap: 10px;
  }

  .gm-modal__cancel,
  .gm-modal__confirm {
    flex: 1;
    padding: 11px 16px;
    border-radius: 99px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .875rem;
    cursor: pointer;
    transition: opacity .15s, scale .15s;
    border: none;
  }
  .gm-modal__cancel:hover,
  .gm-modal__confirm:hover  { opacity: .85; }
  .gm-modal__cancel:active,
  .gm-modal__confirm:active { scale: .97; }

  .gm-modal__cancel {
    background: var(--cream-2);
    border: 1.5px solid var(--cream-border);
    color: var(--ink-2);
  }

  .gm-modal__confirm {
    background: var(--ink);
    color: var(--cream);
  }

  /* ── Solución ─────────────────────────────────────────────── */
  .gm-solution {
    background: var(--cream-2);
    border: 1.5px solid var(--cream-border);
    border-left: 4px solid var(--blood);
    border-radius: 16px;
    padding: 28px 32px;
    min-height: 140px;
  }

  .gm-solution__label {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: .75rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--blood);
    margin-bottom: 14px;
  }

  .gm-solution__text {
    font-family: var(--f-serif);
    font-size: 1.2rem;
    line-height: 1.7;
    color: var(--ink);
  }
</style>

<script>
  function initGM() {
    const curtain = document.getElementById('gm-curtain');
    const modal   = document.getElementById('gm-modal');
    const backdrop = document.getElementById('gm-backdrop');
    const btnCancel  = document.getElementById('gm-cancel');
    const btnConfirm = document.getElementById('gm-confirm');

    if (!curtain || !modal) return;

    let revealed = false;
    const key = `gm::${window.location.pathname}`;

    function openModal() {
      if (revealed) return;
      modal.removeAttribute('hidden');
      btnConfirm?.focus();
    }

    function closeModal() {
      modal.setAttribute('hidden', '');
    }

    function reveal() {
      closeModal();
      revealed = true;
      curtain.classList.add('open');
      sessionStorage.setItem(key, '1');
      setTimeout(() => {
        curtain.setAttribute('aria-hidden', 'true');
        curtain.setAttribute('tabindex', '-1');
        curtain.style.pointerEvents = 'none';
      }, 800);
    }

    // Restaurar si ya estaba revelado
    if (sessionStorage.getItem(key)) {
      revealed = true;
      curtain.classList.add('open');
      curtain.setAttribute('aria-hidden', 'true');
      curtain.setAttribute('tabindex', '-1');
      curtain.style.pointerEvents = 'none';
    }

    curtain.addEventListener('click', openModal);
    curtain.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(); }
    });
    backdrop?.addEventListener('click', closeModal);
    btnCancel?.addEventListener('click', closeModal);
    btnConfirm?.addEventListener('click', reveal);
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !modal.hasAttribute('hidden')) closeModal();
    });
  }

  document.addEventListener('astro:page-load', initGM);
</script>
