---
interface Props {
  solucion: string;
  accentColor?: string;
  darkCard?: boolean;
}
const {
  solucion,
  accentColor = 'var(--color-blood)',
  darkCard = false,
} = Astro.props;

const overlayBg     = darkCard ? '#0f0000' : '#1a1a2e';
const overlayText   = darkCard ? '#9a7070' : '#9090b0';
const btnBg         = darkCard ? 'rgba(192,57,43,0.15)' : 'rgba(100,80,180,0.12)';
const btnBorder     = darkCard ? 'rgba(192,57,43,0.3)'  : 'rgba(100,80,180,0.25)';
---

<!-- Contenedor relativo que envuelve overlay + solución -->
<section class="relative mt-8">

  <!-- Overlay cortina -->
  <div
    id="gm-overlay"
    class="cortina-overlay absolute inset-0 z-10 rounded-2xl flex items-center justify-center cursor-pointer"
    style={`background: ${overlayBg};`}
    role="button"
    tabindex="0"
    aria-label="Revelar solución — solo para el Game Master"
  >
    <div class="text-center px-6 select-none">
      <!-- Icono -->
      <div
        class="inline-flex items-center justify-center w-14 h-14 rounded-full mb-5 transition-all duration-300"
        style={`background: ${btnBg}; border: 1.5px solid ${btnBorder};`}
        id="gm-icon-wrap"
      >
        <svg class="w-6 h-6" style={`color: ${accentColor};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      <p class="font-display font-600 text-sm uppercase tracking-widest mb-1" style={`color: ${overlayText};`}>
        Solución
      </p>
      <p class="text-xs mb-5" style={`color: ${overlayText}; opacity: 0.6;`}>
        Solo para el Game Master
      </p>

      <div
        class="px-5 py-2 rounded-full font-display font-600 text-xs uppercase tracking-widest"
        style={`background: ${accentColor}22; border: 1.5px solid ${accentColor}55; color: ${accentColor};`}
      >
        Pulsa para revelar
      </div>
    </div>
  </div>

  <!-- Modal de confirmación -->
  <div
    id="gm-modal"
    class="hidden fixed inset-0 z-50 flex items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
  >
    <div id="gm-modal-backdrop" class="absolute inset-0" style="background: rgba(0,0,0,0.7); backdrop-filter: blur(6px);"></div>

    <div
      class="relative z-10 rounded-2xl p-8 max-w-sm w-full text-center shadow-2xl animate-fade-up"
      style="background: var(--color-base); border: 1.5px solid var(--color-base-border);"
    >
      <div
        class="inline-flex items-center justify-center w-12 h-12 rounded-full mb-5"
        style={`background: ${accentColor}15; border: 1.5px solid ${accentColor}40;`}
      >
        <svg class="w-5 h-5" style={`color: ${accentColor};`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
          <circle cx="12" cy="12" r="3"/>
        </svg>
      </div>

      <h3 class="font-display font-700 text-lg mb-2" style="color: var(--color-ink);">¿Eres el Game Master?</h3>
      <p class="text-sm leading-relaxed mb-7" style="color: var(--color-muted);">
        La solución quedará visible. Asegúrate de que los demás jugadores no estén mirando.
      </p>

      <div class="flex gap-3">
        <button
          id="gm-cancel"
          class="flex-1 py-2.5 rounded-full font-display font-500 text-sm border transition-all"
          style="border-color: var(--color-base-border); color: var(--color-muted);"
        >
          Cancelar
        </button>
        <button
          id="gm-confirm"
          class="flex-1 py-2.5 rounded-full font-display font-600 text-sm text-white transition-all hover:opacity-90 active:scale-95"
          style={`background: ${accentColor};`}
        >
          Soy el GM
        </button>
      </div>
    </div>
  </div>

  <!-- Solución (debajo del overlay) -->
  <div
    class="rounded-2xl p-7"
    style="background: var(--color-base-soft); border: 1.5px solid var(--color-base-border); min-height: 140px;"
  >
    <div class="flex items-center gap-2 mb-4">
      <div class="w-1 h-5 rounded-full" style={`background: ${accentColor};`}></div>
      <span class="font-display text-xs font-600 uppercase tracking-widest" style="color: var(--color-muted);">Solución</span>
    </div>
    <p class="font-serif text-xl leading-relaxed" style="color: var(--color-ink); font-size: 1.2rem;">
      {solucion}
    </p>
  </div>

</section>

<script>
  function initGameMaster() {
    const overlay    = document.getElementById('gm-overlay');
    const modal      = document.getElementById('gm-modal');
    const backdrop   = document.getElementById('gm-modal-backdrop');
    const btnCancel  = document.getElementById('gm-cancel');
    const btnConfirm = document.getElementById('gm-confirm');

    if (!overlay || !modal) return;

    let revelado = false;

    function abrirModal() {
      if (revelado) return;
      modal.classList.remove('hidden');
      btnConfirm?.focus();
    }

    function cerrarModal() {
      modal.classList.add('hidden');
    }

    function revelarSolucion() {
      cerrarModal();
      revelado = true;
      overlay.classList.add('revealed');
      sessionStorage.setItem(`gm-${window.location.pathname}`, 'revealed');
      setTimeout(() => {
        overlay.setAttribute('aria-hidden', 'true');
        overlay.setAttribute('tabindex', '-1');
        overlay.style.pointerEvents = 'none';
      }, 850);
    }

    // Restaurar si ya se reveló
    if (sessionStorage.getItem(`gm-${window.location.pathname}`) === 'revealed') {
      revelado = true;
      overlay.classList.add('revealed');
      overlay.setAttribute('aria-hidden', 'true');
      overlay.setAttribute('tabindex', '-1');
      overlay.style.pointerEvents = 'none';
    }

    overlay.addEventListener('click', abrirModal);
    overlay.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') abrirModal();
    });
    backdrop?.addEventListener('click', cerrarModal);
    btnCancel?.addEventListener('click', cerrarModal);
    btnConfirm?.addEventListener('click', revelarSolucion);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) cerrarModal();
    });
  }

  document.addEventListener('astro:page-load', initGameMaster);
</script>
