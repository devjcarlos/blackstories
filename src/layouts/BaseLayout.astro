---
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Historias Negras — El juego de sí o no',
  description = 'Acertijos de situación para grupos. Uno conoce la solución, los demás la descubren preguntando solo sí o no.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3ede3" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>

    <header class="site-header">
      <nav class="container nav-inner">
        <a href="/" class="nav-logo">
          <span class="nav-logo__dot"></span>
          <span class="nav-logo__text">Historias Negras</span>
        </a>
        <div class="nav-links">
          <a href="/jugar" class="nav-link">Jugar</a>
          <a href="/como-jugar" class="nav-link">Cómo jugar</a>
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <span class="footer-logo">Historias Negras</span>
        <span class="footer-copy">Un juego para noches largas</span>
      </div>
    </footer>

  </body>
</html>

<style>
  /* ── Navbar ─────────────────────────────────────────────────── */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: rgba(243, 237, 227, 0.92);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--cream-border);
  }

  .nav-inner {
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .nav-logo__dot {
    width: 18px; height: 18px;
    background: var(--blood);
    border-radius: 3px;
    flex-shrink: 0;
    transition: rotate .3s ease;
  }
  .nav-logo:hover .nav-logo__dot { rotate: 12deg; }

  .nav-logo__text {
    font-family: var(--f-headline);
    font-weight: 700;
    font-size: 1.125rem;
    color: var(--ink);
    letter-spacing: -.01em;
    font-optical-sizing: auto;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav-link {
    font-family: var(--f-sans);
    font-size: .875rem;
    font-weight: 500;
    color: var(--muted);
    text-decoration: none;
    padding: 6px 12px;
    border-radius: 8px;
    transition: color .15s, background .15s;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--cream-2);
  }

  /* ── Layout ─────────────────────────────────────────────────── */
  main { padding-top: 56px; }

  /* ── Footer ─────────────────────────────────────────────────── */
  .site-footer {
    margin-top: 96px;
    border-top: 1px solid var(--cream-border);
    padding: 32px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .footer-logo {
    font-family: var(--f-headline);
    font-weight: 700;
    font-size: .9375rem;
    color: var(--ink-2);
    font-optical-sizing: auto;
  }

  .footer-copy {
    font-family: var(--f-serif);
    font-style: italic;
    font-size: .875rem;
    color: var(--muted);
  }
</style>
