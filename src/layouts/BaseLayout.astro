---
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Historias Negras — El juego de sí o no',
  description = 'Acertijos de situación para grupos. Uno conoce la solución, los demás deben descubrirla solo preguntando sí o no.',
  ogImage = '/og-default.png',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- PWA -->
    <meta name="theme-color" content="#09090b" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <title>{title}</title>

    <!-- View Transitions: activa la magia de Astro -->
    <ClientRouter />
  </head>
  <body>
    <!-- Navbar -->
    <header class="fixed top-0 left-0 right-0 z-50 border-b border-zinc-800/50 backdrop-blur-md bg-zinc-950/80">
      <nav class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a
          href="/"
          class="flex items-center gap-2 group"
          transition:name="nav-logo"
        >
          <span class="text-blood text-xl font-serif font-semibold tracking-tight group-hover:opacity-80 transition-opacity">
            Historias Negras
          </span>
        </a>

        <div class="flex items-center gap-1">
          <a
            href="/jugar"
            class="px-3 py-1.5 text-sm text-zinc-400 hover:text-zinc-100 transition-colors rounded-md hover:bg-zinc-800/50"
          >
            Jugar
          </a>
          <a
            href="/como-jugar"
            class="px-3 py-1.5 text-sm text-zinc-400 hover:text-zinc-100 transition-colors rounded-md hover:bg-zinc-800/50"
          >
            Cómo jugar
          </a>
        </div>
      </nav>
    </header>

    <!-- Main content -->
    <main class="pt-14">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-zinc-800/50 mt-24 py-10 text-center text-sm text-zinc-600">
      <p>Historias Negras &mdash; Un juego para noches largas</p>
    </footer>
  </body>
</html>
