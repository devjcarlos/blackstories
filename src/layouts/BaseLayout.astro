---
import ClientRouter from 'astro/components/ClientRouter.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Historias Negras — El juego de sí o no',
  description = 'Acertijos de situación para grupos. Uno conoce la solución, los demás deben descubrirla solo preguntando sí o no.',
  ogImage = '/og-default.png',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4efe6" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>

    <!-- ─── Navbar ─────────────────────────────────────────────── -->
    <header
      class="fixed top-0 left-0 right-0 z-50 border-b"
      style="background: rgba(244,239,230,0.88); backdrop-filter: blur(14px); border-color: var(--color-base-border);"
    >
      <nav class="max-w-6xl mx-auto px-5 h-14 flex items-center justify-between">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group" transition:name="nav-logo">
          <!-- Pequeño cuadrado de acento -->
          <span
            class="w-5 h-5 rounded-sm flex-shrink-0 transition-transform group-hover:rotate-12 duration-300"
            style="background: var(--color-blood);"
          ></span>
          <span
            class="font-display font-700 text-lg tracking-tight leading-none"
            style="color: var(--color-ink);"
          >
            Historias Negras
          </span>
        </a>

        <!-- Nav links -->
        <div class="flex items-center gap-1">
          <a
            href="/jugar"
            class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
            style="color: var(--color-muted);"
            onmouseover="this.style.color='var(--color-ink)'; this.style.background='var(--color-base-soft)'"
            onmouseout="this.style.color='var(--color-muted)'; this.style.background='transparent'"
          >
            Jugar
          </a>
          <a
            href="/como-jugar"
            class="px-3 py-1.5 text-sm font-medium rounded-md transition-colors"
            style="color: var(--color-muted);"
            onmouseover="this.style.color='var(--color-ink)'; this.style.background='var(--color-base-soft)'"
            onmouseout="this.style.color='var(--color-muted)'; this.style.background='transparent'"
          >
            Cómo jugar
          </a>
        </div>
      </nav>
    </header>

    <!-- ─── Main ────────────────────────────────────────────────── -->
    <main class="pt-14">
      <slot />
    </main>

    <!-- ─── Footer ─────────────────────────────────────────────── -->
    <footer
      class="border-t mt-24 py-10 text-center text-sm"
      style="border-color: var(--color-base-border); color: var(--color-muted);"
    >
      <p style="font-family: var(--font-display);">Historias Negras &mdash; Un juego para noches largas</p>
    </footer>

  </body>
</html>
